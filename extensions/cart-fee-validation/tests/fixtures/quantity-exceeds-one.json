{
  "payload": {
    "export": "cart_validations_generate_run",
    "target": "cart.validations.generate.run",
    "input": {
      "shop": {
        "metafield": {
          "jsonValue": {
            "enabled": true,
            "required": true,
            "feeVariantId": "gid://shopify/ProductVariant/fee"
          }
        }
      },
      "cart": {
        "lines": [
          {
            "quantity": 1,
            "merchandise": {
              "__typename": "ProductVariant",
              "id": "gid://shopify/ProductVariant/item"
            }
          }
        ]
      }
    },
    "output": {
      "operations": [
        {
          "validationAdd": {
            "errors": [
              {
                "message": "A required fee is missing. Return to your cart to add it before checkout.",
                "target": "$.cart"
              }
            ]
          }
        }
      ]
    }
  }
}
